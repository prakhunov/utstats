[Unit]
Description=UTStats Caddy (TLS, static assets, FastCGI to PHP)
Requires=utstats-php.service
After=utstats-php.service

[Container]
ContainerName=utstats-caddy
Image=docker.io/library/caddy:2
Network=utstats.network
EnvironmentFile=/etc/utstats/caddy.env
PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp
Volume=/opt/utstats/current/docker/caddy/Caddyfile:/etc/caddy/Caddyfile:ro,z
# Static files come from the same release the PHP image was built from.
Volume=/opt/utstats/current:/var/www/html:ro,z
Volume=utstats-caddy:/data

[Service]
Restart=always

[Install]
WantedBy=multi-user.target

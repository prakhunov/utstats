{
    "name": "passionategaming/utstats",
    "description": "UTStats for utstats.passionategaming.eu",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "ext-pdo_mysql": "*",
        "ext-gd": "*",
        "ext-ftp": "*",
        "maxmind-db/reader": "^1.12"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.2",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
